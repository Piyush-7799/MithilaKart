# MithilaKart Frontend — Environment Variables
# Copy this file to .env and adjust as needed.
# VITE_ prefix is required — Vite only exposes variables with this prefix to the browser.
# NEVER put secrets or DATABASE_URL here.

# ── Backend API URL ───────────────────────────────────────────────────────────
# Must point to the running MithilaKart backend (backend/src/server.ts).
# In development, the backend runs on port 4000 by default.
# In production, replace with your deployed API URL.
VITE_API_URL=http://localhost:4000/api
