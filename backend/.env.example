# MithilaKart API — Environment Variables
# Copy this file to .env and fill in your values.
# NEVER commit .env to git.

# ── PostgreSQL Connection ─────────────────────────────────────────────────────
# Format: postgresql://USER:PASSWORD@HOST:PORT/DATABASE?schema=public
DATABASE_URL="postgresql://postgres:password@localhost:5432/mithilakart?schema=public"

# ── Express Server ────────────────────────────────────────────────────────────
PORT=4000

# ── CORS ──────────────────────────────────────────────────────────────────────
# Must match the URL where the Vite frontend is served.
CLIENT_URL="http://localhost:5173"

# ── Environment ───────────────────────────────────────────────────────────────
NODE_ENV="development"

# ── Authentication ────────────────────────────────────────────────────────────
JWT_SECRET=
